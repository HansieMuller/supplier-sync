#!/usr/bin/env ruby
require "fileutils"
require_relative "../lib/demo_config"
Dir.chdir(File.expand_path("..", __dir__)) do
  system("bundle", "check") || system("bundle", "install", exception: true)
  DemoConfig.load!
  system("bin/rails", "db:prepare", "db:seed", exception: true)
  puts "Ready. Run bin/dev, then bin/demo-password for local operator access."
end
